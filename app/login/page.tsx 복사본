'use client';

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL || '',
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || ''
);

export default function LoginPage() {
  const router = useRouter();
  const [userId, setUserId] = useState('');
  const [password, setPassword] = useState('');
  const [rememberMe, setRememberMe] = useState(false);
  const [loading, setLoading] = useState(false);
  const [alertMessage, setAlertMessage] = useState<string | null>(null);

  useEffect(() => {
    const savedId = localStorage.getItem('saved_user_id');
    const savedPw = localStorage.getItem('saved_user_pw');
    if (savedId) {
      setUserId(savedId);
      if (savedPw) setPassword(savedPw);
      setRememberMe(true);
    }
  }, []);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();

    const cleanInputId = userId.trim();
    const cleanPassword = password.trim();

    if (!cleanInputId || !cleanPassword) {
      setAlertMessage('아이디와 비밀번호를 모두 입력해 주세요.');
      return;
    }

    setLoading(true);

    try {
      // 1. app_users 테이블 전체 조회
      const { data: users, error } = await supabase
        .from('app_users')
        .select('*');

      if (error) {
        setAlertMessage(`DB 조회 오류: ${error.message}\n(Supabase RLS 설정 또는 테이블을 확인하세요)`);
        setLoading(false);
        return;
      }

      if (!users || users.length === 0) {
        setAlertMessage('DB에서 사용자 데이터를 가져올 수 없습니다. RLS 권한을 확인해 주세요.');
        setLoading(false);
        return;
      }

      // 입력한 아이디와 대소문자/공백 무관하게 비교하여 유저 찾기
      const user = users.find((u: any) => {
        const targetId = String(u.id || u.아이디 || u.user_id || u.ID || '').trim().toLowerCase();
        return targetId === cleanInputId.toLowerCase();
      });

      if (!user) {
        setAlertMessage(`'${cleanInputId}' 아이디를 찾을 수 없습니다.`);
        setLoading(false);
        return;
      }

      // 2. 비밀번호(생년월일) 비교
      const rawDbPw = user.password ?? user.비밀번호 ?? user.pw ?? user.PW ?? '';
      const dbPassword = String(rawDbPw).trim();

      if (dbPassword !== cleanPassword) {
        setAlertMessage('비밀번호가 일치하지 않습니다.');
        setLoading(false);
        return;
      }

      // 3. 세션 데이터 추출
      const foundId = user.id || user.아이디 || user.user_id || user.ID || cleanInputId;
      const foundName = user.name || user.이름 || '사용자';
      const rawRole = user.role || user.권한 || user.ROLE || 'USER';

      // admin -> SUPER_ADMIN 매핑
      const foundRole = String(rawRole).toUpperCase() === 'ADMIN' ? 'SUPER_ADMIN' : rawRole;

      // 4. 아이디/비밀번호 저장 옵션 처리
      if (rememberMe) {
        localStorage.setItem('saved_user_id', foundId);
        localStorage.setItem('saved_user_pw', cleanPassword);
      } else {
        localStorage.removeItem('saved_user_id');
        localStorage.removeItem('saved_user_pw');
      }

      // 5. 세션 정보 저장 및 이동
      const currentUserData = {
        id: foundId,
        name: foundName,
        role: foundRole
      };

      localStorage.setItem('currentUser', JSON.stringify(currentUserData));
      localStorage.setItem('login_timestamp', new Date().getTime().toString());

      setAlertMessage(`${currentUserData.name}님 환영합니다!`);

    } catch (err: any) {
      setAlertMessage(`오류 발생: ${err.message || err}`);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ minHeight: '100vh', display: 'flex', alignItems: 'center', justifyContent: 'center', backgroundColor: '#f3f4f6', padding: '20px' }}>
      <div style={{ maxWidth: '400px', width: '100%', backgroundColor: '#ffffff', borderRadius: '12px', boxShadow: '0 10px 25px rgba(0,0,0,0.1)', padding: '32px' }}>
        <h2 style={{ fontSize: '24px', fontWeight: 'bold', textAlign: 'center', marginBottom: '24px', color: '#111827' }}>로그인</h2>

        <form onSubmit={handleLogin} style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          <div>
            <label style={{ display: 'block', fontSize: '14px', fontWeight: '500', color: '#374151', marginBottom: '6px' }}>아이디</label>
            <input
              type="text"
              placeholder="아이디 입력"
              value={userId}
              onChange={(e) => setUserId(e.target.value)}
              style={{ width: '100%', padding: '10px 14px', border: '1px solid #d1d5db', borderRadius: '8px', fontSize: '15px', color: '#000', boxSizing: 'border-box' }}
            />
          </div>

          <div>
            <label style={{ display: 'block', fontSize: '14px', fontWeight: '500', color: '#374151', marginBottom: '6px' }}>비밀번호 (생년월일)</label>
            <input
              type="password"
              placeholder="비밀번호 입력"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              style={{ width: '100%', padding: '10px 14px', border: '1px solid #d1d5db', borderRadius: '8px', fontSize: '15px', color: '#000', boxSizing: 'border-box' }}
            />
          </div>

          <div style={{ display: 'flex', alignItems: 'center' }}>
            <label style={{ display: 'flex', alignItems: 'center', fontSize: '14px', color: '#4b5563', cursor: 'pointer' }}>
              <input
                type="checkbox"
                checked={rememberMe}
                onChange={(e) => setRememberMe(e.target.checked)}
                style={{ width: '16px', height: '16px', marginRight: '8px' }}
              />
              아이디/비밀번호 저장
            </label>
          </div>

          <button
            type="submit"
            disabled={loading}
            style={{
              width: '100%',
              padding: '12px',
              backgroundColor: loading ? '#9ca3af' : '#2563eb',
              color: '#ffffff',
              fontWeight: '600',
              borderRadius: '8px',
              border: 'none',
              cursor: loading ? 'not-allowed' : 'pointer',
              fontSize: '16px'
            }}
          >
            {loading ? '확인 중...' : '로그인'}
          </button>
        </form>
      </div>

      {/* 알림 팝업 모달 */}
      {alertMessage && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0, 0, 0, 0.6)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 999999,
          padding: '20px'
        }}>
          <div style={{
            backgroundColor: '#ffffff',
            borderRadius: '12px',
            padding: '24px',
            maxWidth: '380px',
            width: '100%',
            textAlign: 'center',
            boxShadow: '0 20px 25px -5px rgba(0, 0, 0, 0.3)'
          }}>
            <p style={{
              fontSize: '15px',
              color: '#1f2937',
              marginBottom: '20px',
              fontWeight: '500',
              whiteSpace: 'pre-wrap',
              lineHeight: '1.5'
            }}>
              {alertMessage}
            </p>
            <button
              onClick={() => {
                const isSuccess = alertMessage.includes('환영합니다');
                setAlertMessage(null);
                if (isSuccess) {
                  router.push('/main');
                }
              }}
              style={{
                width: '100%',
                padding: '10px',
                backgroundColor: '#2563eb',
                color: '#ffffff',
                border: 'none',
                borderRadius: '8px',
                fontWeight: '600',
                fontSize: '14px',
                cursor: 'pointer'
              }}
            >
              닫기
            </button>
          </div>
        </div>
      )}
    </div>
  );
}